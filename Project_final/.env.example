# Copy to .env for local use; never commit actual API keys.
# On Render, set these values in the service's Environment settings.
GNEWS_API_KEY=
TAVILY_API_KEY=
GROQ_API_KEY=

# Non-secret model ID. Availability is controlled by your Groq account.
GROQ_MODEL=openai/gpt-oss-20b

# Tavily is configured in code for basic search (one credit per request).
# Serper is no longer used. Restart Uvicorn after changing .env.
